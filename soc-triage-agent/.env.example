ELASTIC_URL=https://localhost:9200
ELASTIC_API_KEY=
ELASTIC_CA_CERT=
ELASTIC_ALERT_INDEX=.alerts-security.alerts-default
ELASTIC_TELEMETRY_INDICES=logs-*
ELASTIC_NGINX_INDEX=logs-nginx.access-*
POLL_INTERVAL_SECONDS=5
MAX_QUERY_RESULTS=100
MAX_QUERY_WINDOW_MINUTES=30
MAX_TOOL_RESULT_BYTES=20000
ELASTIC_SEARCH_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO
OPENAI_API_KEY=
OPENAI_MODEL=
PROMPT_INSPECTION_MODE=log
LOG_LLM_REQUESTS=true
LOG_LLM_RESPONSES=true
LOG_TOOL_CALLS=true
LOG_TOOL_RESULTS=true
LOG_TRIAGE_RESULTS=true
MAX_TOOL_CALLS=5
MAX_MODEL_REQUESTS=8
INVESTIGATION_TRACING_ENABLED=true
INVESTIGATION_TRACE_DIRECTORY=logs/investigations
INVESTIGATION_TRACE_ELASTIC_ENABLED=true
ELASTIC_TRIAGE_RESULTS_INDEX=soc-triage-results-v1
ELASTIC_TRIAGE_TRACES_INDEX=soc-triage-traces-v1
ELASTIC_WRITER_API_KEY=
EXPERIMENT_ID=
RUN_NUMBER=
AGENT_MODE=triage
